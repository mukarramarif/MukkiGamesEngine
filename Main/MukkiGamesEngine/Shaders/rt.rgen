#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;
layout(set = 0, binding = 9, rgba32f) uniform image2D accumImage;
const int MAX_LIGHTS = 4;
const int LIGHT_TYPE_DIRECTIONAL = 0;
const int LIGHT_TYPE_POINT = 1;
const int LIGHT_TYPE_SPOT = 2;

struct Light
{
    vec4 position;
    vec4 color;
    vec4 direction;
    vec4 attenuation;
};

layout(set = 0, binding = 2) uniform RayTracingScene {
    mat4 invView;
    mat4 invProj;
    vec4 cameraPos;
    mat4 model;
    mat4 invModel;
    mat4 normalMatrix;
    Light lights[MAX_LIGHTS];
    vec4 lightParams;
    vec4 jitter;
} sceneData;

layout(set = 0, binding = 7) uniform samplerCube cubemapSampler;

struct Payload
{
    vec3 color;
    vec3 position;
    vec3 normal;
    int hit;
    int shadowRay;
    float metallic;
    float roughness;
    vec3 emissiveColor;
    float transmission;
    float idxReflect;
    int frontFace;
    float hitT;
    float attenuationR;
    float attenuationG;
    float attenuationB;
    float attenuationDistance;
    float dispersion;
    float iridescenceFactor;
    float iridescenceIor;
    float iridescenceMin;
    float iridescenceMax;
    int metallicRoughnessTextureIndex;
    float iridescenceThickness;
};

layout(location = 0) rayPayloadEXT Payload payload;

const float kPi = 3.14159265359;

uint pcgHash(uint v)
{
    v = v * 747796405u + 2891336453u;
    v = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    v = (v >> 22u) ^ v;
    return v;
}

float rand(inout uint state)
{
    state = pcgHash(state);
    return float(state) / 4294967296.0;
}

vec3 cosineSampleHemisphere(vec3 normal, inout uint state)
{
    float r1 = rand(state);
    float r2 = rand(state);
    float phi = 2.0 * kPi * r1;
    float cosTheta = sqrt(1.0 - r2);  // PDF = cosTheta / kPi
    float sinTheta = sqrt(r2);

    // Build orthonormal basis from the normal
    vec3 tangent = normalize(abs(normal.y) < 0.999
        ? cross(normal, vec3(0.0, 1.0, 0.0))
        : cross(normal, vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * cos(phi) * sinTheta + bitangent * sin(phi) * sinTheta + normal * cosTheta);
}
float causticIOR(float ior, float dispersion, float lambda){
    float b = (ior - 1.0) * dispersion / 1.910;
    return ior + b * (1.0 / (lambda * lambda)-2.882);
}
vec3 wavelengthToRGB(float lambda){
    const float sigma = 0.055;
    vec3 w = vec3(
        exp(-0.5 * pow((lambda - 0.645) / sigma, 2.0)),
        exp(-0.5 * pow((lambda - 0.550) / sigma, 2.0)),
        exp(-0.5 * pow((lambda - 0.460) / sigma, 2.0)));
    return w / 0.345;
}
// vec3 Fresnel0ToIor(vec3 F0) {
//     vec3 sqrtF0 = sqrt(F0);
//     return (vec3(1.0) + sqrtF0) / (vec3(1.0) - sqrtF0);
// }
// float IorToFresnel0(float transmittedIor, float incidentIor) {
//     return pow((transmittedIor - incidentIor) / (transmittedIor + incidentIor), 2.0);
// }
/**
    For the thin film interference effect, we can use the Fresnel equations to calculate the reflection and transmission coefficients at the interfaces of the thin film. The function below calculates the Fresnel reflection coefficient for a thin film given the cosine of the angle of incidence, the refractive index of the thin film, the refractive index of the base material, and the thickness of the thin film.
*/
vec3 iridescenceFresnel(float cosTheta, float filmIor, float thickness, vec3 baseF0)
{
    float c0 = clamp(cosTheta, 0.0, 1.0);
    float n0 = 1.0;                     // air
    float n1 = max(filmIor, 1.0);       // thin film

    // Substrate IOR per channel (dielectric F0=0.04 -> 1.5, metals from baseColor)
    vec3 sqrtF0 = sqrt(clamp(baseF0, 0.0, 1.0));
    vec3 n2 = (vec3(1.0) + sqrtF0) / max(vec3(1.0) - sqrtF0, vec3(0.001));

    float sin0Sq = 1.0 - c0 * c0;
    float sin1Sq = (n0 * n0 / (n1 * n1)) * sin0Sq;
    vec3  sin2Sq = (n1 * n1 / (n2 * n2)) * sin1Sq;
    float c1 = sqrt(max(1.0 - sin1Sq, 0.0));
    vec3  c2 = sqrt(max(vec3(1.0) - sin2Sq, vec3(0.0)));

    // Amplitude reflection coefficients: s and p polarization
    float rs12 = (n0 * c0 - n1 * c1) / max(n0 * c0 + n1 * c1, 1e-5);
    vec3  rs23 = (n1 * c1 - n2 * c2) / max(n1 * c1 + n2 * c2, vec3(1e-5));
    float rp12 = (n1 * c0 - n0 * c1) / max(n1 * c0 + n0 * c1, 1e-5);
    vec3  rp23 = (n2 * c1 - n1 * c2) / max(n2 * c1 + n1 * c2, vec3(1e-5));

    float Rs12 = rs12 * rs12;
    vec3  Rs23 = rs23 * rs23;
    float Rp12 = rp12 * rp12;
    vec3  Rp23 = rp23 * rp23;

    // Round-trip phase per RGB channel (wavelengths in nm)
    vec3 lambda = vec3(650.0, 510.0, 475.0);
    vec3 phase = (4.0 * kPi * n1 * thickness * c1) / lambda;

    vec3 cosPhase = cos(phase);
    vec3 Rs = (Rs12 + Rs23 + 2.0 * sqrt(Rs12 * Rs23) * cosPhase)
            / (vec3(1.0) + Rs12 * Rs23 + 2.0 * sqrt(Rs12 * Rs23) * cosPhase);
    vec3 Rp = (Rp12 + Rp23 + 2.0 * sqrt(Rp12 * Rp23) * cosPhase)
            / (vec3(1.0) + Rp12 * Rp23 + 2.0 * sqrt(Rp12 * Rp23) * cosPhase);
    return 0.5 * (Rs + Rp);
}
void main()
{
    vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5) + sceneData.jitter.xy;
    vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 clip = vec4(ndc, 1.0, 1.0);
    vec4 view = sceneData.invProj * clip;
    view /= view.w;
    vec3 origin = sceneData.cameraPos.xyz;
    vec3 direction = normalize((sceneData.invView * vec4(view.xyz, 0.0)).xyz);

    vec3 result = vec3(0.0);
    vec3 throughput = vec3(1.0);
    const int maxBounces = 5;
    int frameCount = int(sceneData.lightParams.w + 0.5);
    uint rngState = (gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x) ^ (uint(frameCount) * 9781u);
    rngState = pcgHash(rngState);

    float glassLambda = -1.0;
    for (int bounce = 0; bounce < maxBounces; ++bounce)
    {
        payload.hit = 0;
        payload.shadowRay = 0;
        traceRayEXT(
            topLevelAS,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            0,
            0,
            0,
            origin,
            0.001,
            direction,
            10000.0,
            0
        );
        if (payload.hit == 0)
        {
            vec3 cubemapColor = texture(cubemapSampler, direction).rgb;
            result += throughput * cubemapColor;
            break;
        }
        //snapshot of values before the bounce
        float transmission = payload.transmission;
        float idxReflect = payload.idxReflect;
        int frontFace = payload.frontFace;
        float hitT = payload.hitT;
        float attenR = payload.attenuationR;
        float attenG = payload.attenuationG;
        float attenB = payload.attenuationB;
        float attenDist = payload.attenuationDistance;
        float dispersion = payload.dispersion;
        float iridFactor = payload.iridescenceFactor;
        float iridIor = payload.iridescenceIor;
        float iridMin = payload.iridescenceMin;
        float iridMax = payload.iridescenceMax;
        float iridThickness = payload.iridescenceThickness;
        float filmThickness = iridThickness > 0.0 ? iridThickness : mix(iridMin, iridMax, 0.5);

        if(payload.transmission < 0.01){
            glassLambda = -1.0f;
        }
        vec3 albedo = payload.color;
        vec3 hitPos = payload.position;
        vec3 normal = normalize(payload.normal);
        vec3 viewDir = normalize(sceneData.cameraPos.xyz - hitPos);
        int lightCount = int(sceneData.lightParams.x + 0.5);
        float ambientStrength = sceneData.lightParams.y;
        float metallic = payload.metallic;
        float roughnessVal = max(payload.roughness, 0.001);
        float roughness2 = roughnessVal * roughnessVal;

        vec3 F0 = mix(vec3(0.04), albedo, metallic);

        // Emissive contribution from the surface
        result += throughput * payload.emissiveColor;

        vec3 lighting = vec3(0.0);
        for (int i = 0; i < lightCount && i < MAX_LIGHTS; ++i)
        {
            Light light = sceneData.lights[i];
            int lightType = int(light.attenuation.w + 0.5);
            vec3 lightDir = vec3(0.0);
            float attenuation = 1.0;
            float maxDistance = 10000.0;
            float intensity = 1.0;

            if (lightType == LIGHT_TYPE_DIRECTIONAL)
            {
                lightDir = normalize(-light.direction.xyz);
            }
            else
            {
                vec3 toLight = light.position.xyz - hitPos;
                float distance = length(toLight);
                if (distance > 0.0)
                {
                    lightDir = toLight / distance;
                    maxDistance = distance;
                }
                float constantAtt = light.attenuation.x;
                float linearAtt = light.attenuation.y;
                float quadraticAtt = light.attenuation.z;
                attenuation = 1.0 / (constantAtt + linearAtt * distance + quadraticAtt * distance * distance);

                if (lightType == LIGHT_TYPE_SPOT)
                {
                    float theta = dot(lightDir, normalize(-light.direction.xyz));
                    float cutoff = light.direction.w;
                    float outerCutoff = cutoff - 0.1;
                    float epsilon = cutoff - outerCutoff;
                    intensity = clamp((theta - outerCutoff) / epsilon, 0.0, 1.0);
                }
            }

            if (intensity <= 0.0)
            {
                continue;
            }

            payload.hit = 0;
            payload.shadowRay = 1;
            traceRayEXT(
                topLevelAS,
                gl_RayFlagsNoneEXT,
                0xFF,     // cullMask
                0,        // sbtRecordOffset
                0,        // sbtRecordStride
                0,        // missIndex
                hitPos + normal * 0.01,   // origin
                0.001,    // tMin
                lightDir, // direction
                maxDistance,              // tMax
                0         // payload location (constant!)
            );
            float opaqueShadow = payload.hit == 1 ? 0.0 : 1.0;

            // Shadow test 2: glass occlusion (glass blocks)
            payload.hit = 0;
            payload.shadowRay = 2;
            traceRayEXT(
                topLevelAS,
                gl_RayFlagsNoneEXT,
                0xFF,
                0,
                0,
                0,
                hitPos + normal * 0.01,
                0.001,
                lightDir,
                maxDistance,
                0
            );
            float glassShadow = payload.hit == 1 ? 0.0 : 1.0;

            const float glassShadowStrength = 0.5;
            float shadow = opaqueShadow * mix(1.0, glassShadow, glassShadowStrength);

            if (shadow <= 0.0)
            {
                continue;
            }

            float nDotL = max(dot(normal, lightDir), 0.0);
            if (nDotL <= 0.0)
            {
                continue;
            }

            vec3 halfwayDir = normalize(lightDir + viewDir);
            float nDotH = max(dot(normal, halfwayDir), 0.0);
            float nDotV = max(dot(normal, viewDir), 0.0);

            // GGX distribution
            float a2 = roughness2 * roughness2;
            float nDotH2 = nDotH * nDotH;
            float denom = nDotH2 * (a2 - 1.0) + 1.0;
            float NDF = a2 / (kPi * denom * denom);

            // Geometry (Schlick-GGX)
            float k = (roughnessVal + 1.0) * (roughnessVal + 1.0) / 8.0;
            float G = (nDotL / (nDotL * (1.0 - k) + k)) * (nDotV / (nDotV * (1.0 - k) + k));

            // Fresnel
                       // Fresnel (thin-film iridescence on the dielectric part)
            float hDotV = max(dot(halfwayDir, viewDir), 0.0);
            vec3 F;
            if (iridFactor > 0.001) {
                vec3 Fbase = F0 + (vec3(1.0) - F0) * pow(1.0 - hDotV, 5.0);
                vec3 Ffilm = iridescenceFresnel(hDotV, iridIor, filmThickness, F0);
                F = mix(Fbase, Ffilm, iridFactor);
            } else {
                F = F0 + (1.0 - F0) * pow(1.0 - hDotV, 5.0);
            }

            vec3 kS = F;

            vec3 kD = (vec3(1.0) - kS) * (1.0 - metallic);

            vec3 specular = (NDF * G * F) / max(4.0 * nDotV * nDotL, 0.001);
            vec3 diffuse = kD * albedo / kPi;
            lighting += (diffuse + specular) * light.color.rgb * light.color.a * nDotL * attenuation * intensity * shadow;
        }

        vec3 ambient = ambientStrength * albedo;
        if(payload.transmission < 0.01){
            result+=throughput * (ambient+lighting);

        }


        if (payload.transmission > 0.01) {
            // ── Glass: Fresnel-weighted reflection vs. refraction ──
            float iorF0 = ((idxReflect - 1.0) / (idxReflect + 1.0));
            iorF0 *= iorF0;
            float cosTheta = max(dot(-direction, normal), 0.0);
            vec3 Firid = vec3(iorF0) + (vec3(1.0) - vec3(iorF0)) * pow(1.0 - cosTheta, 5.0);
            if (iridFactor > 0.001) {
                vec3 Ffilm = iridescenceFresnel(cosTheta, iridIor, filmThickness, vec3(iorF0));
                Firid = mix(Firid, Ffilm, iridFactor);
            }

            float F = max(max(Firid.r, Firid.g), Firid.b);



            if (rand(rngState) < F) {
                // Reflect (F already accounted in probability)
                direction = reflect(direction, normal);
                origin = hitPos + normal * 0.01;
                throughput *= Firid / max(F, 1e-3);
            } else {
                 // ── Spectral dispersion: one random wavelength per glass segment ──
                float lambda = 0.55;   // neutral default
                if (dispersion > 0.0) {
                    if (frontFace == 1) {
                        // Entering: sample a new wavelength, remember it for the exit
                        lambda = mix(0.38, 0.78, rand(rngState));
                        glassLambda = lambda;
                        throughput *= wavelengthToRGB(lambda);
                    } else if (glassLambda > 0.0) {
                        lambda = glassLambda;               // exiting: same wavelength
                    } else {
                        // Ray began inside the glass (camera in the volume)
                        lambda = mix(0.38, 0.78, rand(rngState));
                        throughput *= wavelengthToRGB(lambda);
                    }
                }

                float baseIor = max(idxReflect, 1.0001);
                float eta;
                if (dispersion > 0.0) {
                    float dispIOR = causticIOR(baseIor, dispersion, lambda);
                    eta = (frontFace == 1) ? (1.0 / max(dispIOR, 1.0001)) : max(dispIOR, 1.0001);
                } else {
                    eta = (frontFace == 1) ? (1.0 / baseIor) : baseIor;
                }

                vec3 refrDir = refract(direction, normal, eta);
                if (dot(refrDir, refrDir) < 0.001) {
                    direction = reflect(direction, normal);
                    origin = hitPos + normal * 0.01;
                    throughput *= Firid / max(F, 1e-3);
                } else {
                    direction = refrDir;
                    origin = hitPos + refrDir * 0.01;
                    // Beer's law tint for the segment just traveled through glass
                    if (frontFace == 0 && attenDist > 0.0) {
                        vec3 atten = max(vec3(attenR, attenG, attenB), vec3(0.0001));
                        throughput *= pow(atten, vec3(hitT / attenDist));
                    }
                }
            }
        } else {

            // Fresnel throughput split for the next bounce direction
            vec3 bounceViewDir = normalize(sceneData.cameraPos.xyz - hitPos);
            float bounceNdotV = max(dot(normal, bounceViewDir), 0.0);
            vec3 bounceF;
            if (iridFactor > 0.001) {
                vec3 Fbase = F0 + (vec3(1.0) - F0) * pow(1.0 - bounceNdotV, 5.0);
                vec3 Ffilm = iridescenceFresnel(bounceNdotV, iridIor, filmThickness, F0);
                bounceF = mix(Fbase, Ffilm, iridFactor);
            } else {
                bounceF = F0 + (1.0 - F0) * pow(1.0 - bounceNdotV, 5.0);
            }

            float reflectProb = max(max(bounceF.r, bounceF.g), bounceF.b);


            if (rand(rngState) < reflectProb) {
                // Specular bounce
                direction = reflect(direction, normal);
                throughput *= bounceF / reflectProb;
            } else {
                // Diffuse bounce
                direction = cosineSampleHemisphere(normal, rngState);
                throughput *= (vec3(1.0) - bounceF) * albedo / (1.0 - reflectProb);
            }
            origin = hitPos + normal * 0.01;
        }
    }

    ivec2 p = ivec2(gl_LaunchIDEXT.xy);
    vec4 prev = imageLoad(accumImage, p);
    vec3 accumulated = prev.rgb * float(frameCount) + result;
    accumulated /= float(frameCount + 1);
    //previous red->blue issues was coming from sRGB swapping b and r
    imageStore(accumImage, p, vec4(accumulated, 1.0));
    // tone mapping and gamma correction
    vec3 displayColor = accumulated / (accumulated+vec3(1.0));
    // encoding to sRGB
    displayColor = mix(pow(displayColor, vec3(1.0/2.4)) * 1.055-0.055, displayColor * 12.92, lessThan(displayColor, vec3(0.0031308)));
    // Swapping R/B for swapchaing BGRA for correct display
    imageStore(outputImage, p, vec4(displayColor.bgr, 1.0));
}

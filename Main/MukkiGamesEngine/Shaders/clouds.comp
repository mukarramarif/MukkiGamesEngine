#version 450
// 16x16 workgroup for efficient GPU occupancy
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Descriptor bindings — written by CloudPipeline on host side
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;   // composited output
layout(set = 0, binding = 1) uniform sampler2D sceneColor;                    // captured raster scene
layout(set = 0, binding = 2) uniform sampler2D depthTexture;                  // depth buffer (sky detection)
layout(set = 0, binding = 3) uniform sampler3D noise3D;                       // 64³ RG8: perlin(R) + worley(G)
layout(set = 0, binding = 4) uniform sampler2D weatherMap;                    // 256² R8: cloud coverage

layout(push_constant) uniform PushConstants {
    vec2  iResolution;  // render target dimensions
    float iTime;        // elapsed seconds for cloud drift
} pc;

void main()
{
    // UV in Vulkan framebuffer space: (0,0)=top-left, (1,1)=bottom-right
    vec2 uv = vec2(gl_GlobalInvocationID.xy) / pc.iResolution;
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    // Read the rasterized scene (geometry + skybox) and depth
    vec3 sceneCol = textureLod(sceneColor, uv, 0.0).rgb;
    float depth = textureLod(depthTexture, uv, 0.0).r;

    // Determine if this pixel is sky: depth == far-plane (1.0) means no geometry hit
    bool isSky = (depth >= 0.999);

    // Default: pass scene through unchanged
    vec3 color = sceneCol;

    if (isSky)
    {
        // Reconstruct a view-direction ray from the full-screen UV.
        // Vulkan flips Y relative to OpenGL, so we invert uv.y so that
        // the top of the screen maps to positive Y (looking up).
        vec3 rd = normalize(vec3(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0, 2.0));

        // Only march into the cloud layer when looking above the horizon
        if (rd.y > 0.1)
        {
            // Intersect the ray with a cloud plane at altitude 1200 world-units
            float t = 1200.0 / rd.y;

            // World-space position on the cloud plane
            vec3 cloudPos = rd * t;

            // Animate clouds drifting horizontally over time
            cloudPos.xz += pc.iTime * 8.0;

            // --- Coverage masking ---
            // Scale world coordinates down to weather-map texture space.
            // The weather map controls where clouds appear (0=clear, 1=overcast).
            vec2 weatherUV = cloudPos.xz * 0.0002;
            float coverage = texture(weatherMap, weatherUV).r;

            // --- Noise sampling ---
            // Scale into the 3D noise texture's coordinate range.
            // The 64³ volume wraps via REPEAT addressing (configured on the sampler).
            cloudPos *= 0.0008;

            // R channel: base perlin-noise shape (soft billowy forms)
            float perlin = texture(noise3D, cloudPos).r;
            // G channel: higher-frequency worley noise (wispy detail)
            float worley = texture(noise3D, cloudPos * 2.5).g;

            // Blend perlin and worley for cloud-like structure
            float density = perlin * 0.55 + worley * 0.45;

            // Sharpen the density edge so clouds have defined borders
            density = smoothstep(0.38, 0.72, density);

            // Mask out areas where the weather map says 'clear sky'
            density *= coverage;

            // Fade clouds toward the horizon so they don't touch the ground
            float horizonFade = smoothstep(0.05, 0.25, rd.y);
            density *= horizonFade;

            // Darken dense clouds for depth, brighten thin edges
            vec3 cloudColor = mix(vec3(0.85, 0.87, 0.92), vec3(1.0, 0.99, 0.96), density);

            // Source-over blend on top of the scene (skybox / sky gradient)
            color = mix(sceneCol, cloudColor, density * 0.85);
        }
    }

    imageStore(outputImage, pixelCoord, vec4(color, 1.0));
}

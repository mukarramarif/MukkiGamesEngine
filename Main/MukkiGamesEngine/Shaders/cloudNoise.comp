#version 450

/*
    Pre-bakes a tileable 3D noise texture for volumetric cloud rendering.

    Channels:
        R  – Perlin-Worley²   (base cloud shape, sharpened)
        G  – Worley FBM        (medium-frequency detail / erosion)
        B  – Worley FBM        (higher-frequency detail)
        A  – Worley FBM        (highest-frequency detail)

    Based on TileableVolumeNoise by Sebastien Hillarie
    and the Nubis/Decima cloud system (Siggraph 2017).
*/

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba8, binding = 0) uniform writeonly image3D outVolTex;

layout(push_constant) uniform PushConstants {
    int   noiseResX, noiseResY, noiseResZ;
    float perlinFreq;
    int   perlinOctaves;
} pc;

// ---------------------------------------------------------------------------
// Noise primitives  (TileableVolumeNoise – Sebastien Hillarie)
// ---------------------------------------------------------------------------

const float FREQ_MUL[6] = float[](2.0, 8.0, 14.0, 20.0, 26.0, 32.0);

float hash(int n) {
    return fract(sin(float(n) + 1.951) * 43758.5453123);
}

float noise3(vec3 x) {
    vec3 p = floor(x);
    vec3 f = fract(x);
    f = f * f * (vec3(3.0) - vec3(2.0) * f);
    float n = p.x + p.y * 57.0 + 113.0 * p.z;
    return mix(
        mix(mix(hash(int(n + 0.0)),   hash(int(n + 1.0)),   f.x),
            mix(hash(int(n + 57.0)),  hash(int(n + 58.0)),  f.x), f.y),
        mix(mix(hash(int(n + 113.0)), hash(int(n + 114.0)), f.x),
            mix(hash(int(n + 170.0)), hash(int(n + 171.0)), f.x), f.y),
        f.z);
}
vec3 hash3(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}
float worley3D(vec3 p, float cellCount) {
    vec3 pCell = p * cellCount;
    float d = 1.0e10;
    for (int xo = -1; xo <= 1; xo++) {
        for (int yo = -1; yo <= 1; yo++) {
            for (int zo = -1; zo <= 1; zo++) {
                vec3 tp = floor(pCell) + vec3(xo, yo, zo);
                tp = pCell - tp - hash3(mod(tp, cellCount / 1.0));
                d = min(d, dot(tp, tp));
            }
        }
    }
    return clamp(d, 0.0, 1.0);
}

// ---------------------------------------------------------------------------
// 4-D Perlin  (from GLM gtc/noise.hpp)
// ---------------------------------------------------------------------------

vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
vec4 taylorInvSqrt(vec4 r) { return vec4(1.79284291400159) - 0.85373472095314 * r; }
vec4 fade4(vec4 t) { return (t * t * t) * (t * (t * 6.0 - 15.0) + 10.0); }

float perlin4D(vec4 P, vec4 rep) {
    vec4 Pi0 = mod(floor(P), rep);
    vec4 Pi1 = mod(Pi0 + 1.0, rep);
    vec4 Pf0 = fract(P);
    vec4 Pf1 = Pf0 - 1.0;

    vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
    vec4 iy = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
    vec4 iz0 = vec4(Pi0.z);
    vec4 iz1 = vec4(Pi1.z);
    vec4 iw0 = vec4(Pi0.w);
    vec4 iw1 = vec4(Pi1.w);

    vec4 ixy = permute(permute(ix) + iy);
    vec4 ixy0 = permute(ixy + iz0);
    vec4 ixy1 = permute(ixy + iz1);

    vec4 gx00 = permute(ixy0 + iw0) / 7.0;
    vec4 gy00 = floor(gx00) / 7.0;
    vec4 gz00 = floor(gy00) / 6.0;
    gx00 = fract(gx00) - 0.5;
    gy00 = fract(gy00) - 0.5;
    gz00 = fract(gz00) - 0.5;
    vec4 gw00 = 0.75 - abs(gx00) - abs(gy00) - abs(gz00);
    vec4 sw00 = step(gw00, vec4(0.0));
    gx00 -= sw00 * (step(0.0, gx00) - 0.5);
    gy00 -= sw00 * (step(0.0, gy00) - 0.5);

    vec4 gx10 = permute(ixy1 + iw0) / 7.0;
    vec4 gy10 = floor(gx10) / 7.0;
    vec4 gz10 = floor(gy10) / 6.0;
    gx10 = fract(gx10) - 0.5;
    gy10 = fract(gy10) - 0.5;
    gz10 = fract(gz10) - 0.5;
    vec4 gw10 = 0.75 - abs(gx10) - abs(gy10) - abs(gz10);
    vec4 sw10 = step(gw10, vec4(0.0));
    gx10 -= sw10 * (step(0.0, gx10) - 0.5);
    gy10 -= sw10 * (step(0.0, gy10) - 0.5);

    vec4 gx01 = permute(ixy0 + iw1) / 7.0;
    vec4 gy01 = floor(gx01) / 7.0;
    vec4 gz01 = floor(gy01) / 6.0;
    gx01 = fract(gx01) - 0.5;
    gy01 = fract(gy01) - 0.5;
    gz01 = fract(gz01) - 0.5;
    vec4 gw01 = 0.75 - abs(gx01) - abs(gy01) - abs(gz01);
    vec4 sw01 = step(gw01, vec4(0.0));
    gx01 -= sw01 * (step(0.0, gx01) - 0.5);
    gy01 -= sw01 * (step(0.0, gy01) - 0.5);

    vec4 gx11 = permute(ixy1 + iw1) / 7.0;
    vec4 gy11 = floor(gx11) / 7.0;
    vec4 gz11 = floor(gy11) / 6.0;
    gx11 = fract(gx11) - 0.5;
    gy11 = fract(gy11) - 0.5;
    gz11 = fract(gz11) - 0.5;
    vec4 gw11 = 0.75 - abs(gx11) - abs(gy11) - abs(gz11);
    vec4 sw11 = step(gw11, vec4(0.0));
    gx11 -= sw11 * (step(0.0, gx11) - 0.5);
    gy11 -= sw11 * (step(0.0, gy11) - 0.5);

    vec4 g0000 = vec4(gx00.x, gy00.x, gz00.x, gw00.x);
    vec4 g1000 = vec4(gx00.y, gy00.y, gz00.y, gw00.y);
    vec4 g0100 = vec4(gx00.z, gy00.z, gz00.z, gw00.z);
    vec4 g1100 = vec4(gx00.w, gy00.w, gz00.w, gw00.w);
    vec4 g0010 = vec4(gx10.x, gy10.x, gz10.x, gw10.x);
    vec4 g1010 = vec4(gx10.y, gy10.y, gz10.y, gw10.y);
    vec4 g0110 = vec4(gx10.z, gy10.z, gz10.z, gw10.z);
    vec4 g1110 = vec4(gx10.w, gy10.w, gz10.w, gw10.w);
    vec4 g0001 = vec4(gx01.x, gy01.x, gz01.x, gw01.x);
    vec4 g1001 = vec4(gx01.y, gy01.y, gz01.y, gw01.y);
    vec4 g0101 = vec4(gx01.z, gy01.z, gz01.z, gw01.z);
    vec4 g1101 = vec4(gx01.w, gy01.w, gz01.w, gw01.w);
    vec4 g0011 = vec4(gx11.x, gy11.x, gz11.x, gw11.x);
    vec4 g1011 = vec4(gx11.y, gy11.y, gz11.y, gw11.y);
    vec4 g0111 = vec4(gx11.z, gy11.z, gz11.z, gw11.z);
    vec4 g1111 = vec4(gx11.w, gy11.w, gz11.w, gw11.w);

    vec4 n00 = taylorInvSqrt(vec4(dot(g0000,g0000), dot(g0100,g0100), dot(g1000,g1000), dot(g1100,g1100)));
    vec4 n01 = taylorInvSqrt(vec4(dot(g0001,g0001), dot(g0101,g0101), dot(g1001,g1001), dot(g1101,g1101)));
    vec4 n10 = taylorInvSqrt(vec4(dot(g0010,g0010), dot(g0110,g0110), dot(g1010,g1010), dot(g1110,g1110)));
    vec4 n11 = taylorInvSqrt(vec4(dot(g0011,g0011), dot(g0111,g0111), dot(g1011,g1011), dot(g1111,g1111)));
    g0000*=n00.x; g0100*=n00.y; g1000*=n00.z; g1100*=n00.w;
    g0001*=n01.x; g0101*=n01.y; g1001*=n01.z; g1101*=n01.w;
    g0010*=n10.x; g0110*=n10.y; g1010*=n10.z; g1110*=n10.w;
    g0011*=n11.x; g0111*=n11.y; g1011*=n11.z; g1111*=n11.w;

    float n0000 = dot(g0000, Pf0);
    float n1000 = dot(g1000, vec4(Pf1.x, Pf0.y, Pf0.z, Pf0.w));
    float n0100 = dot(g0100, vec4(Pf0.x, Pf1.y, Pf0.z, Pf0.w));
    float n1100 = dot(g1100, vec4(Pf1.x, Pf1.y, Pf0.z, Pf0.w));
    float n0010 = dot(g0010, vec4(Pf0.x, Pf0.y, Pf1.z, Pf0.w));
    float n1010 = dot(g1010, vec4(Pf1.x, Pf0.y, Pf1.z, Pf0.w));
    float n0110 = dot(g0110, vec4(Pf0.x, Pf1.y, Pf1.z, Pf0.w));
    float n1110 = dot(g1110, vec4(Pf1.x, Pf1.y, Pf1.z, Pf0.w));
    float n0001 = dot(g0001, vec4(Pf0.x, Pf0.y, Pf0.z, Pf1.w));
    float n1001 = dot(g1001, vec4(Pf1.x, Pf0.y, Pf0.z, Pf1.w));
    float n0101 = dot(g0101, vec4(Pf0.x, Pf1.y, Pf0.z, Pf1.w));
    float n1101 = dot(g1101, vec4(Pf1.x, Pf1.y, Pf0.z, Pf1.w));
    float n0011 = dot(g0011, vec4(Pf0.x, Pf0.y, Pf1.z, Pf1.w));
    float n1011 = dot(g1011, vec4(Pf1.x, Pf0.y, Pf1.z, Pf1.w));
    float n0111 = dot(g0111, vec4(Pf0.x, Pf1.y, Pf1.z, Pf1.w));
    float n1111 = dot(g1111, Pf1);

    vec4 f4 = fade4(Pf0);
    vec4 n_0w = mix(vec4(n0000,n1000,n0100,n1100), vec4(n0001,n1001,n0101,n1101), f4.w);
    vec4 n_1w = mix(vec4(n0010,n1010,n0110,n1110), vec4(n0011,n1011,n0111,n1111), f4.w);
    vec4 n_zw = mix(n_0w, n_1w, f4.z);
    vec2 n_yzw = mix(n_zw.xy, n_zw.zw, f4.y);
    return 2.2 * mix(n_yzw.x, n_yzw.y, f4.x);
}

// ---------------------------------------------------------------------------
// Multi-octave builders
// ---------------------------------------------------------------------------

float remap(float v, float lo, float hi, float newLo, float newHi) {
    return newLo + ((v - lo) / (hi - lo)) * (newHi - newLo);
}

float perlinFBM(vec3 coord, float frequency, int octaves) {
    float sum       = 0.0;
    float weightSum = 0.0;
    float weight    = 0.5;
    float freq      = frequency;

    for (int oct = 0; oct < 16; oct++) {
        if (oct >= octaves) break;
        vec4 p = vec4(coord, 0.0) * freq;
        float val = perlin4D(p, vec4(freq));
        sum       += val * weight;
        weightSum += weight;
        weight    *= 0.5;
        freq      *= 2.0;
    }
    return clamp(sum / weightSum, 0.0, 1.0);
}

// ---------------------------------------------------------------------------
// Stackable 3-D Noise  (GPU Pro 7, p.101)
// ---------------------------------------------------------------------------

vec4 stackable3DNoise(ivec3 pixel) {
    ivec3 res = ivec3(pc.noiseResX, pc.noiseResY, pc.noiseResZ);
    vec3 coord = vec3(pixel) / vec3(res);

    // --- Perlin FBM (base shape) ---
    float perlin = perlinFBM(coord, pc.perlinFreq, pc.perlinOctaves);

    // --- Perlin-Worley (R channel) ---
    float cellCount = 4.0;
    float w0 = 1.0 - worley3D(coord, cellCount * FREQ_MUL[0]);
    float w1 = 1.0 - worley3D(coord, cellCount * FREQ_MUL[1]);
    float w2 = 1.0 - worley3D(coord, cellCount * FREQ_MUL[2]);

    float worleyFBM = w0 * 0.625 + w1 * 0.25 + w2 * 0.125;
    float perlinWorley = remap(perlin, 0.0, 1.0, worleyFBM, 1.0);

    // --- Worley FBM channels (G, B, A) ---
    float w0b = 1.0 - worley3D(coord, cellCount * 1.0);
    float w1b = 1.0 - worley3D(coord, cellCount * 2.0);
    float w2b = 1.0 - worley3D(coord, cellCount * 4.0);
    float w3b = 1.0 - worley3D(coord, cellCount * 8.0);
    float w4b = 1.0 - worley3D(coord, cellCount * 16.0);

    float worleyFBM0 = w1b * 0.625 + w2b * 0.25 + w3b * 0.125;
    float worleyFBM1 = w2b * 0.625 + w3b * 0.25 + w4b * 0.125;
    float worleyFBM2 = w3b * 0.75  + w4b * 0.25;

    return clamp(vec4(perlinWorley * perlinWorley,   // R: sharpened base
                      worleyFBM0,                     // G: mid detail
                      worleyFBM1,                     // B: higher detail
                      worleyFBM2),                    // A: highest detail
                 0.0, 1.0);
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

void main() {
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 res   = ivec3(pc.noiseResX, pc.noiseResY, pc.noiseResZ);

    if (any(greaterThanEqual(pixel, res)))
        return;

    imageStore(outVolTex, pixel, stackable3DNoise(pixel));
}
